def parse_args(argv):
    p = argparse.ArgumentParser(
        prog="amethyst-web",
        description="Amethyst Web: apri il browser e gioca, senza installare nulla.",
    )
    p.add_argument("command", nargs="?", default="web",
                   help="usa 'web' per avviare (cosi' funziona anche: amethyst web)")
    p.add_argument("--port", type=int, default=DEFAULT_PORT, help="porta locale (default 8080)")
    p.add_argument("--host", default=DEFAULT_HOST, help="host di bind (default 127.0.0.1)")
    p.add_argument("--no-open", action="store_true", help="non aprire il browser in automatico")
    p.add_argument("--version", action="store_true", help="mostra versione ed esci")
    return p.parse_args(argv)


def find_free_port(host, start, tries=20):
    for port in range(start, start + tries):
        with socket.socket(socket.AF_INET, socket.SOCK_STREAM) as s:
            s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
            try:
                s.bind((host, port))
                return port
            except OSError:
                continue
    return start


def try_launch_app():
    """Prova ad aprire l'app Amethyst installata (solo Android). Ritorna (ok, messaggio)."""
    cmds = [
        ["am", "start", "-n", f"{PKG_RELEASE}/{MAIN_ACTIVITY}"],
        ["am", "start", "-n", f"{PKG_DEBUG}/{MAIN_ACTIVITY}"],
    ]
    if shutil.which("am") is None and not shutil.which("termux-open-url"):
        return False, "Comando 'am' non trovato: non sei su Android. Apri manualmente l'app Amethyst."
    for cmd in cmds:
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=10)
            out = (r.stdout + r.stderr).lower()
            if r.returncode == 0 and "error" not in out:
                return True, "Amethyst Launcher aperto! Premi Play per la versione completa."
        except FileNotFoundError:
            continue
        except Exception as e:  # noqa: BLE001
            return False, f"Avvio non riuscito ({e}). Apri manualmente l'app Amethyst."
    return False, "App Amethyst non trovata sul dispositivo. Scarica prima l'APK."


def open_browser(url):
    if shutil.which("termux-open-url"):
        try:
            subprocess.Popen(["termux-open-url", url])
            return True
        except Exception:  # noqa: BLE001
            pass
    if shutil.which("am"):
        try:
            subprocess.Popen(["am", "start", "-a", "android.intent.action.VIEW",
                              "-d", url], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True
        except Exception:  # noqa: BLE001
            pass
    try:
        if webbrowser.open(url):
            return True
    except Exception:  # noqa: BLE001
        pass
    for opener in (["xdg-open", url], ["open", url], ["cmd", "/c", "start", url]):
        try:
            subprocess.Popen(opener, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
            return True
        except Exception:  # noqa: BLE001
            continue
    return False


class Handler(BaseHTTPRequestHandler):
    url = "http://127.0.0.1:8080"

    def log_message(self, fmt, *args):
        sys.stdout.write("  [%s] %s\n" % (self.command, self.path))

    def _send(self, code, body, ctype="text/html; charset=utf-8"):
        data = body.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", ctype)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def do_GET(self):  # noqa: N802
        path = urlparse(self.path).path
        if path in ("/", "/index.html"):
            self._send(200, PAGE_HOME.replace("__URL__", self.url))
        elif path == "/play":
            self._send(200, PAGE_PLAY)
        elif path == "/launcher":
            self._send(200, PAGE_LAUNCHER)
        elif path == "/api/status":
            self._send(200, json.dumps({
                "app": APP_NAME, "version": VERSION, "status": "ok",
                "url": self.url, "game": "clone voxel open-source nel browser (nessun asset Mojang)",
                "full_game": "Minecraft JE originale via app Amethyst (richiede gioco acquistato)",
            }, ensure_ascii=False), "application/json; charset=utf-8")
        elif path == "/api/launch":
            ok, message = try_launch_app()
            self._send(200, json.dumps({"ok": ok, "message": message}, ensure_ascii=False),
                       "application/json; charset=utf-8")
        elif path == "/favicon.ico":
            self.send_response(204)
            self.end_headers()
        else:
            self._send(404, "<h1>404 — pagina non trovata</h1><p><a href='/'>Torna al pannello</a></p>")


def main(argv=None):
    args = parse_args(argv or sys.argv[1:])
    if args.version:
        print(f"{APP_NAME} {VERSION}")
        return 0
    if args.command not in ("web", "serve", "start"):
        print(f"Comando sconosciuto: {args.command}\nUso: amethyst-web [web] [--port PORTA] [--no-open]")
        return 1

    host = args.host
    port = find_free_port(host, args.port)
    if port != args.port:
        print(f"⚠️  Porta {args.port} occupata → uso la {port}.")

    Handler.url = f"http://{host}:{port}"
    server = HTTPServer((host, port), Handler)
    play_url = Handler.url + "/play"

    print(f"\n  💜 {APP_NAME} {VERSION}")
    print(f"  ➜ Pannello: {Handler.url}")
    print(f"  ➜ GIOCA ORA nel browser: {play_url}")
    print("  ➜ Premi CTRL+C per fermare.\n")

    if not args.no_open:
        threading.Timer(0.8, functools.partial(open_browser, play_url)).start()
        print("  🌐 Apro il browser sul gioco...")
        time.sleep(0.1)
    else:
        print("  (apertura browser disattivata — apri l'URL a mano)")

    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n  👋 Server fermato. Alla prossima!")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
