function solid(x,y,z){return !!get(Math.floor(x),Math.floor(y),Math.floor(z));}
function collide(){
  var r=0.3,H=1.8;
  // Y
  P.y+=P.vy;
  if(P.vy<0){
    if(solid(P.x-r,P.y,P.z-r)||solid(P.x+r,P.y,P.z-r)||solid(P.x-r,P.y,P.z+r)||solid(P.x+r,P.y,P.z+r)){
      P.y=Math.floor(P.y)+1;P.vy=0;P.onG=true;
    } else P.onG=false;
  } else if(P.vy>0){
    var top=P.y+H;
    if(solid(P.x-r,top,P.z-r)||solid(P.x+r,top,P.z-r)||solid(P.x-r,top,P.z+r)||solid(P.x+r,top,P.z+r)){
      P.y=Math.ceil(top)-H-0.001;P.vy=0;
    }
  }
  // X
  P.x+=P.vx;
  if(solid(P.x+(P.vx>0?r:-r),P.y+0.3,P.z-r)||solid(P.x+(P.vx>0?r:-r),P.y+0.3,P.z+r)||solid(P.x+(P.vx>0?r:-r),P.y+1.5,P.z)){
    P.x-=P.vx;P.vx=0;
  }
  // Z
  P.z+=P.vz;
  if(solid(P.x-r,P.y+0.3,P.z+(P.vz>0?r:-r))||solid(P.x+r,P.y+0.3,P.z+(P.vz>0?r:-r))||solid(P.x,P.y+1.5,P.z+(P.vz>0?r:-r))){
    P.z-=P.vz;P.vz=0;
  }
  if(P.y<-10){P.y=12;P.vy=0;} // caduto dal mondo
}
// ---------- raycast voxel (DDA) ----------
function raycast(maxD){
  var dx=-Math.sin(P.yaw)*Math.cos(P.pitch),dy=Math.sin(P.pitch),dz=-Math.cos(P.yaw)*Math.cos(P.pitch);
  var x=P.x,y=P.y+1.6,z=P.z;
  var ix=Math.floor(x),iy=Math.floor(y),iz=Math.floor(z);
  var sx=dx>0?1:-1,sy=dy>0?1:-1,sz=dz>0?1:-1;
  var tdx=Math.abs(1/(dx||1e-8)),tdy=Math.abs(1/(dy||1e-8)),tdz=Math.abs(1/(dz||1e-8));
  var tmx=(sx>0?(ix+1-x):(x-ix))*tdx,tmy=(sy>0?(iy+1-y):(y-iy))*tdy,tmz=(sz>0?(iz+1-z):(z-iz))*tdz;
  var nx=0,ny=0,nz=0,t=0;
  for(var i=0;i<100;i++){
    if(tmx<tmy&&tmx<tmz){ix+=sx;t=tmx;tmx+=tdx;nx=-sx;ny=0;nz=0;}
    else if(tmy<tmz){iy+=sy;t=tmy;tmy+=tdy;nx=0;ny=-sy;nz=0;}
    else{iz+=sz;t=tmz;tmz+=tdz;nx=0;ny=0;nz=-sz;}
    if(t>maxD)return null;
    if(get(ix,iy,iz))return {x:ix,y:iy,z:iz,nx:nx,ny:ny,nz:nz};
  }
  return null;
}
